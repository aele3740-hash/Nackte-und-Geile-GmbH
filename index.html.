<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#090a0d">
<title>Nackte und Geile GmbH — Stark. Kreativ. Unverhüllt.</title>
<style>
:root{--bg:#090a0d;--panel:#111319;--text:#f5f6f8;--muted:#a9afbd;--accent:#c6f36b;--line:#292d38}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.6}
a{color:inherit;text-decoration:none}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}
header{position:sticky;top:0;z-index:10;background:rgba(9,10,13,.88);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.logo{font-weight:950;letter-spacing:-1.5px;font-size:20px;line-height:1.05}.logo span{display:block;color:var(--accent);font-size:10px;letter-spacing:4px;margin-top:6px}
nav{display:flex;gap:25px;color:var(--muted);font-size:14px}nav a:hover,nav a.active{color:var(--text)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;border:1px solid var(--line);padding:12px 18px;border-radius:999px;font-weight:700;font-size:14px;transition:.2s;cursor:pointer}.btn:hover{transform:translateY(-2px);border-color:var(--accent)}.btn.primary{background:var(--accent);color:#10120a;border-color:var(--accent)}
.menu{display:none;background:none;border:1px solid var(--line);color:white;border-radius:10px;padding:8px 11px;font-size:20px}
.hero{padding:100px 0 86px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 78% 30%,#283047 0%,transparent 40%),linear-gradient(130deg,#090a0d 30%,#111520 100%)}
.hero:after{content:"";position:absolute;right:-10%;top:8%;width:48%;height:90%;border:1px solid #ffffff13;transform:skewY(-17deg);background:linear-gradient(145deg,#ffffff0b,#ffffff00);pointer-events:none}
.kicker{color:var(--accent);text-transform:uppercase;letter-spacing:4px;font-size:12px;font-weight:800}.hero h1{font-size:clamp(46px,8vw,94px);line-height:.96;letter-spacing:-5px;max-width:850px;margin:22px 0}.hero h1 em{font-style:normal;color:var(--accent)}.hero p{color:var(--muted);font-size:18px;max-width:610px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.hero-note{margin-top:58px;color:#727989;font-size:12px;letter-spacing:1.5px;text-transform:uppercase}
section{padding:82px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:30px}.section-head h2{font-size:clamp(30px,5vw,48px);line-height:1.08;letter-spacing:-2px;margin:10px 0 0}.section-head p{max-width:420px;color:var(--muted);margin:0}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{padding:26px;border:1px solid var(--line);background:linear-gradient(145deg,#13161d,#0d0f14);border-radius:18px;min-height:220px}.number{color:var(--accent);font-size:12px;letter-spacing:2px;font-weight:800}.card h3{font-size:23px;margin:32px 0 8px}.card p{color:var(--muted);margin:0}
.about{background:#0e1016;border-block:1px solid var(--line)}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center}.about h2{font-size:clamp(34px,5vw,56px);line-height:1.05;letter-spacing:-2px;margin:12px 0 20px}.about p{color:var(--muted)}.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.stat{border:1px solid var(--line);border-radius:15px;padding:22px}.stat strong{display:block;font-size:28px;color:var(--accent)}.stat span{font-size:13px;color:var(--muted)}
.contact-box{border:1px solid #414a32;background:radial-gradient(ellipse at 90% 10%,#26301b,#111319 55%);padding:clamp(25px,5vw,55px);border-radius:24px;display:flex;justify-content:space-between;align-items:center;gap:25px}.contact-box h2{font-size:clamp(30px,5vw,50px);line-height:1.05;letter-spacing:-2px;margin:12px 0}.contact-box p{color:var(--muted);max-width:520px}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:13px}.foot{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.footlinks{display:flex;gap:18px}.foot a:hover{color:var(--accent)}
.modal{position:fixed;inset:0;background:#000b;display:none;place-items:center;padding:20px;z-index:30}.modal.open{display:grid}.modal-inner{width:min(520px,100%);background:var(--panel);border:1px solid var(--line);padding:28px;border-radius:18px;position:relative}.modal-inner h2{margin-top:0}.close{position:absolute;right:15px;top:12px;border:0;background:none;color:white;font-size:25px;cursor:pointer}label{display:block;font-size:13px;margin:12px 0 6px;color:var(--muted)}input,textarea{width:100%;padding:12px;background:#090a0d;border:1px solid var(--line);border-radius:10px;color:white;font:inherit}textarea{min-height:100px;resize:vertical}.notice{color:var(--muted);font-size:12px;margin-top:10px}
@media(max-width:760px){nav{display:none;position:absolute;top:76px;left:0;right:0;padding:20px;background:#090a0d;border-bottom:1px solid var(--line);flex-direction:column;gap:18px}nav.open{display:flex}.menu{display:block}.nav>.btn{display:none}.hero{padding:75px 0 65px}.hero h1{letter-spacing:-2.5px}.cards{grid-template-columns:1fr}.section-head,.about-grid{display:grid;grid-template-columns:1fr}.contact-box{align-items:flex-start;flex-direction:column}.about-grid{gap:25px}section{padding:60px 0}}
</style>
</head>
<body>
<header>
  <div class="wrap nav">
    <a class="logo" href="#start">NACKTE <span>UND GEILE GMBH</span></a>
    <nav id="navlinks">
      <a class="active" href="#start">Start</a><a href="#leistungen">Leistungen</a><a href="#ueber-uns">Über uns</a><a href="#kontakt">Kontakt</a>
    </nav>
    <a class="btn primary" href="#kontakt">Let’s go ↗</a>
    <button class="menu" id="menuBtn" aria-label="Menü öffnen" aria-expanded="false">☰</button>
  </div>
</header>
<main>
  <section class="hero" id="start">
    <div class="wrap">
      <div class="kicker">Ungewöhnlich im Namen. Stark im Auftritt.</div>
      <h1>NACKTE IDEEN.<br><em>GEILE ERGEBNISSE.</em></h1>
      <p>Willkommen bei der Nackte und Geile GmbH. Wir denken mutig, machen Dinge anders und bringen Ideen auf den Punkt — ohne unnötigen Schnickschnack.</p>
      <div class="actions"><a class="btn primary" href="#leistungen">Was wir machen ↓</a><a class="btn" href="#ueber-uns">Lern uns kennen</a></div>
      <div class="hero-note">Klar. Kreativ. Unverwechselbar.</div>
    </div>
  </section>
  <section id="leistungen">
    <div class="wrap">
      <div class="section-head"><div><div class="kicker">Was wir draufhaben</div><h2>Gute Ideen. Sauber umgesetzt.</h2></div><p>Von der ersten verrückten Idee bis zum fertigen Auftritt: Wir machen aus „Was wäre, wenn …?“ einen Plan.</p></div>
      <div class="cards">
        <article class="card"><div class="number">01 / KONZEPT</div><h3>Kreative Ideen</h3><p>Frische Konzepte mit Charakter — mutig gedacht und verständlich auf den Punkt gebracht.</p></article>
        <article class="card"><div class="number">02 / DESIGN</div><h3>Starker Auftritt</h3><p>Ein Look, der auffällt, im Kopf bleibt und zu deiner Marke passt.</p></article>
        <article class="card"><div class="number">03 / UMSETZUNG</div><h3>Einfach machen</h3><p>Weniger heiße Luft, mehr Ergebnisse. Gemeinsam bringen wir Projekte ins Ziel.</p></article>
      </div>
    </div>
  </section>
  <section class="about" id="ueber-uns">
    <div class="wrap about-grid">
      <div><div class="kicker">Wer wir sind</div><h2>Wir nehmen Ideen ernst. Uns selbst nicht immer.</h2><p>Die Nackte und Geile GmbH steht für Kreativität, klare Ansagen und einen eigenen Kopf. Unser Name ist Programm: nichts verstecken, keine langweiligen Standards — einfach gute Arbeit mit Persönlichkeit.</p><a class="btn" href="#kontakt">Zusammenarbeiten ↗</a></div>
      <div class="stat-grid"><div class="stat"><strong>100%</strong><span>eigener Stil</span></div><div class="stat"><strong>0</strong><span>Lust auf 08/15</span></div><div class="stat"><strong>1 Team</strong><span>ein gemeinsames Ziel</span></div><div class="stat"><strong>∞</strong><span>Ideen im Kopf</span></div></div>
    </div>
  </section>
  <section id="kontakt">
    <div class="wrap"><div class="contact-box"><div><div class="kicker">Deine Idee wartet</div><h2>Mach’s nicht langweilig.</h2><p>Du hast ein Projekt oder willst einfach mal Hallo sagen? Schreib uns — wir freuen uns auf deine Nachricht.</p></div><button class="btn primary" id="openContact">Kontakt aufnehmen ↗</button></div></div>
  </section>
</main>
<footer><div class="wrap foot"><a class="logo" href="#start">NACKTE <span>UND GEILE GMBH</span></a><span>© <span id="year"></span> Nackte und Geile GmbH</span><div class="footlinks"><a href="#" id="impressum">Impressum</a><a href="#" id="datenschutz">Datenschutz</a></div></div></footer>
<div class="modal" id="contactModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-inner"><button class="close" id="closeContact" aria-label="Schließen">×</button><h2 id="modalTitle">Schreib uns.</h2><p style="color:var(--muted)">Das Formular ist eine Demo. Es versendet noch keine Nachricht.</p>
    <form id="contactForm"><label for="name">Dein Name</label><input id="name" name="name" required placeholder="Max Mustermann"><label for="email">Deine E-Mail</label><input id="email" name="email" type="email" required placeholder="max@beispiel.de"><label for="message">Deine Nachricht</label><textarea id="message" name="message" required placeholder="Erzähl uns, worum es geht …"></textarea><button class="btn primary" style="margin-top:15px" type="submit">Nachricht vorbereiten ↗</button><p class="notice" id="formNotice">Demo-Webseite: Noch kein Versand eingerichtet.</p></form>
  </div>
</div>
<script>
const menuBtn=document.getElementById('menuBtn'),nav=document.getElementById('navlinks'),modal=document.getElementById('contactModal');
menuBtn.addEventListener('click',()=>{const open=nav.classList.toggle('open');menuBtn.setAttribute('aria-expanded',String(open));menuBtn.textContent=open?'×':'☰'});
nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');menuBtn.setAttribute('aria-expanded','false');menuBtn.textContent='☰'}));
document.getElementById('year').textContent=new Date().getFullYear();
document.getElementById('openContact').addEventListener('click',()=>{modal.classList.add('open');document.getElementById('name').focus()});
document.getElementById('closeContact').addEventListener('click',()=>modal.classList.remove('open'));
modal.addEventListener('click',e=>{if(e.target===modal)modal.classList.remove('open')});
document.addEventListener('keydown',e=>{if(e.key==='Escape')modal.classList.remove('open')});
document.getElementById('contactForm').addEventListener('submit',e=>{e.preventDefault();const d=new FormData(e.target);const subject=encodeURIComponent('Anfrage von '+d.get('name'));const body=encodeURIComponent(d.get('message')+'\n\nName: '+d.get('name')+'\nE-Mail: '+d.get('email'));document.getElementById('formNotice').textContent='Dein E-Mail-Programm sollte sich jetzt öffnen. Dafür muss eine Mail-App eingerichtet sein.';window.location.href='mailto:kontakt@example.com?subject='+subject+'&body='+body});
document.getElementById('impressum').addEventListener('click',e=>{e.preventDefault();alert('Bitte vor Veröffentlichung die echten Unternehmensdaten und die rechtlich erforderlichen Angaben ergänzen.')});
document.getElementById('datenschutz').addEventListener('click',e=>{e.preventDefault();alert('Bitte vor Veröffentlichung eine passende Datenschutzerklärung ergänzen.')});
</script>
</body>
</html>
